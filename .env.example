JWT_SECRET=change-me

# Used to encrypt access tokens stored in the local database. Keep this value
# stable after configuring a team; changing it makes existing tokens unreadable.
INTEGRATION_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Optional: override the SQLite file location, e.g. a mounted persistent volume
# such as /data/voetbal.sqlite on Railway. Defaults to server/database/voetbal.sqlite.
DATABASE_PATH=
