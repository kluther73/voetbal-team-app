JWT_SECRET=change-me

# Official football-data API connection. Obtain the URLs and token from your
# authorized KNVB/voetbal.nl integration. Use {teamId} where the team id belongs.
VOETBAL_NL_TEAM_ID=your-team-id
VOETBAL_NL_ACCESS_TOKEN=your-access-token
VOETBAL_NL_MATCHES_URL=https://api.example.nl/teams/{teamId}/matches
VOETBAL_NL_TRAININGS_URL=https://api.example.nl/teams/{teamId}/trainings
VOETBAL_NL_PLAYERS_URL=https://api.example.nl/teams/{teamId}/players
# Optional: schedule feed for other teams in the club.
VOETBAL_NL_OTHER_FIXTURES_URL=https://api.example.nl/teams/{teamId}/other-fixtures
